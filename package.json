{
  "name": "skillhub",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.13.0 <25" },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 3300",
    "build": "prisma generate && next build",
    "start": "node scripts/start.mjs",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:integration": "tsx scripts/db-smoke.ts",
    "test:http": "tsx scripts/http-smoke.ts",
    "test:collector": "tsx scripts/collector-smoke.ts",
    "test:admin-http": "tsx scripts/admin-http-smoke.ts",
    "test:collector-live": "tsx scripts/collector-live-smoke.ts",
    "collector:worker": "tsx scripts/collector-worker.ts",
    "collector:once": "tsx scripts/collector-worker.ts --once",
    "admin:grant": "tsx scripts/grant-admin.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "data:refresh": "tsx scripts/fetch-seed.ts"
  },
  "dependencies": {
    "@next-auth/prisma-adapter": "1.0.7",
    "@prisma/client": "6.19.3",
    "@radix-ui/react-slot": "1.4.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "0.468.0",
    "next": "16.4.0",
    "next-auth": "4.24.15",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwind-merge": "3.3.1",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.10.1",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "dotenv": "17.2.3",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.0",
    "prisma": "6.19.3",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  },
  "overrides": { "deepmerge-ts": "8.0.2" }
}
