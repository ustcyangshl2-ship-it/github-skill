# Local URL for port 3300. Production uses its HTTPS origin.
DATABASE_URL=postgresql://skillhub:CHANGE_ME@127.0.0.1:55432/skillhub?schema=public&connection_limit=5
NEXTAUTH_URL=http://localhost:3300
# Generate a random secret: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
NEXTAUTH_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Collector token is separate from OAuth client secret; not needed for P1 snapshots.
GITHUB_TOKEN=
LLM_BASE_URL=https://api.example.com/v1
LLM_API_KEY=
LLM_MODEL=
# Docker Compose: set all values before deployment.
POSTGRES_USER=skillhub
POSTGRES_PASSWORD=
POSTGRES_DB=skillhub
